# ==============================================================
# 校園課業小幫手 LINE Bot - 環境變數範例檔 (.env.example)
#
# 使用方式：
# 1. 複製此檔案並重新命名為「.env」
# 2. 將等號右邊的假值替換成您自己的真實金鑰
# 3. 注意：請勿將填入真實金鑰的 .env 上傳至任何公開版本控制（如 GitHub）
# ==============================================================

# LINE Developers -> 選擇 Provider/Channel -> Basic settings -> Channel secret
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# LINE Developers -> Messaging API -> Channel access token (點擊 Issue 取得長期權限 Token)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Google AI Studio (https://aistudio.google.com/) -> Get API key -> 建立並複製金鑰
GEMINI_API_KEY=your_gemini_api_key_here

# 本機伺服器監聽 Port (選填，預設為 5000)
PORT=5000
